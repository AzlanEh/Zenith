# Maintainer: Azlan Ehtasham <azlanehtesham02@gmail.com>
pkgname=zenith-dw-git
pkgver=r1.abc1234
pkgrel=1
pkgdesc="A high-fidelity digital wellbeing platform for reclaiming cognitive sovereignty (git version)"
arch=('x86_64')
url="https://github.com/Azlaneh/zenith"
license=('MIT')
depends=(
    'webkit2gtk-4.1'
    'gtk3'
    'libappindicator-gtk3'
    'librsvg'
    'libayatana-appindicator'
    'appmenu-gtk-module'
)
makedepends=(
    'rust'
    'cargo'
    'nodejs'
    'npm'
    'pkg-config'
    'openssl'
    'libappindicator-gtk3'
    'librsvg'
    'git'
)
optdepends=(
    'libnotify: desktop notifications'
)
provides=('zenith-dw')
conflicts=('wellbeing' 'wellbeing-git' 'wellbeing-bin')
source=("git+https://github.com/Azlaneh/zenith.git")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/zenith"
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
    cd "$srcdir/zenith"

    # Install npm dependencies
    npm install --prefer-offline
}

build() {
    cd "$srcdir/zenith"

    # Unset makepkg flags that break Rust/C build scripts:
    # - RUSTFLAGS: injects --remap-path-prefix which corrupts bundled sqlite3/ring linking
    # - CFLAGS: -flto=auto causes LTO object files to conflict with bundled static libs
    # - LDFLAGS: may reference flags incompatible with cargo's linker invocation
    export RUSTFLAGS=""
    export CFLAGS=""
    export CXXFLAGS=""
    export LDFLAGS=""

    # Use tauri build so the frontend bundle is embedded (not a devUrl connection)
    npm run tauri -- build --no-bundle
}

package() {
    cd "$srcdir/zenith"

    # Install binary
    install -Dm755 "src-tauri/target/release/zenith" "$pkgdir/usr/bin/zenith-dw"

    # Install desktop file
    install -Dm644 "pkg/linux/arch/zenith-dw.desktop" "$pkgdir/usr/share/applications/zenith-dw.desktop"

    # Install icons
    install -Dm644 "src-tauri/icons/32x32.png" "$pkgdir/usr/share/icons/hicolor/32x32/apps/zenith-dw.png"
    install -Dm644 "src-tauri/icons/128x128.png" "$pkgdir/usr/share/icons/hicolor/128x128/apps/zenith-dw.png"
    install -Dm644 "src-tauri/icons/128x128@2x.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/zenith-dw.png"
    install -Dm644 "src-tauri/icons/icon.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/zenith-dw.png"

    # Install license
    install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE" 2>/dev/null || true
}
